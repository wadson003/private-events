<h1><%= @event.location %></h1>
<p><strong>Date :</strong> <%= @event.date %></p>
<p><strong>Organise par :</strong> <%= @event.creator.email %></p>

<hr>

<% if user_signed_in? && !@event.attendees.include?(current_user) %>
  <%= button_to "Participer a cet evenement", event_attendances_path(@event), method: :post %>
<% end %>

<h3> Liste des participants (<%= @event.attendees.count %>)</h3>
<ul>
    <%@event.attendees.each do |attendee| %>
      <li><%= attendee.email %></li>
    <% end %>
</ul>
