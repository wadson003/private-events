
<h1>Profil de <%= @user.email %></h1>

<h2>Événements créés par cet utilisateur :</h2>
<ul>
  <% @created_events.each do |event| %>
    <li><%= link_to event.location, event_path(event) %> (<%= event.date %>)</li>
  <% end %>
</ul>

<h2>Événements à venir auxquels il participe :</h2>
<ul>
  <% @upcoming_events.each do |event| %>
    <li><%= link_to event.location, event_path(event) %> (<%= event.date %>)</li>
  <% end %>
</ul>

<h2>Événements passés auxquels il a participé :</h2>
<ul>
  <% @past_events.each do |event| %>
    <li><%= link_to event.location, event_path(event) %> (<%= event.date %>)</li>
  <% end %>
</ul>